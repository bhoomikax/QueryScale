# Copy to .env (never committed) and set DB_PASSWORD.
#
# Docker Compose reads DB_PASSWORD, DB_NAME, DB_TEST_NAME, and the *_HOST_PORT values from
# this file. Inside containers it always uses DB_HOST=queryscale-mysql, DB_PORT=3306,
# DB_USER=root, so the DB_HOST/DB_PORT/DB_USER lines below only affect Python run directly
# on Windows.
#
# Direct Python on Windows against the Docker MySQL:   DB_HOST=127.0.0.1  DB_PORT=3307  DB_USER=root
# Direct Python on Windows against the MySQL80 service: DB_HOST=127.0.0.1  DB_PORT=3306  (that server's own user/password)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=queryscale
# Must differ from DB_NAME, compared case-insensitively. Benchmarks drop and recreate it.
DB_TEST_NAME=queryscale_test
DB_USER=root
# Docker: becomes the MySQL root password when the data volume is first created.
# Changing it later does not change the password stored in an existing volume.
DB_PASSWORD=change_me
DB_CHARSET=utf8mb4

# Docker host port mappings (container ports stay 3306 and 8000)
MYSQL_HOST_PORT=3307
API_HOST_PORT=8000

# thread: the API runs jobs itself (direct Python). Compose sets queue + one worker container.
JOB_EXECUTION_MODE=thread
WORKER_POLL_SECONDS=2
QUERY_LOG_PATH=data/query_logs.csv
RECOMMENDATION_PATH=data/recommendations.csv
BENCHMARK_RESULT_PATH=data/benchmark_results.csv
QUERY_FEATURE_PATH=data/query_features.csv
FEATURE_PATH=data/candidate_features.csv
CANDIDATE_PATH=data/index_candidates.csv
SCHEMA_METADATA_PATH=data/schema_metadata.json
BENCHMARK_HISTORY_PATH=data/benchmark_history.jsonl
# auto: live MySQL metadata if reachable, else the saved snapshot, else database/schema.sql
METADATA_SOURCE=auto
METADATA_EXACT_STATS_MAX_ROWS=1000000
MAX_INDEX_CANDIDATES=40
MAX_CANDIDATES_PER_TABLE=10
MAX_INDEX_COLUMNS=3
# Optional JSON file overriding rule-based scoring weights
RULE_WEIGHTS_PATH=
MODEL_DIR=models
ML_MIN_TRAINING_SAMPLES=20
ML_MIN_TRAINING_GROUPS=5
# Keep false: models trained on synthetic demonstration labels must not rank real recommendations
ML_ALLOW_SYNTHETIC_MODEL=false
BENCHMARK_QUERY_TIMEOUT_MS=30000
BENCHMARK_WRITE_PROBE_SAMPLES=25
BENCHMARK_SEED=42
JOB_DATABASE_PATH=runtime/queryscale_jobs.sqlite3
# local or s3. s3 requires boto3 and the two settings below.
ARTIFACT_STORE=local
S3_ARTIFACT_BUCKET=
S3_ARTIFACT_PREFIX=queryscale
LOG_LEVEL=INFO
# text or json (json is recommended for CloudWatch)
LOG_FORMAT=text
