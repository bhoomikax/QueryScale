# Environment files
.env
.env.*
!.env.example

# Python cache and venvs
__pycache__/
*.py[cod]
venv/
.venv/

# OS/editor artifacts
.DS_Store
.idea/
.vscode/

# Local database artifacts
*.log

# Python packaging
*.egg-info/

# Generated runtime state and model artifacts
/runtime/
/models/

# Local benchmark history, metadata snapshots, backups, and job stores
data/benchmark_history.jsonl
data/schema_metadata.json
data_backup/
*.sqlite3
data/query_features.csv

# Terraform (infra/): never commit state, provider caches, or per-user inputs
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
infra/**/backend.hcl
infra/**/*.tfvars
!infra/**/*.tfvars.example
infra/**/override.tf
infra/**/override.tf.json
infra/**/*_override.tf
infra/**/*_override.tf.json
