# Copy to environments/dev.tfvars (gitignored) and edit. Never put passwords here;
# database passwords are generated by Terraform and stored only in Secrets Manager
# and the encrypted remote state.

region      = "us-east-1"
name_prefix = "queryscale"
environment = "dev"

# Who may reach the unauthenticated API. Replace with your own address(es).
alb_allowed_cidrs = ["203.0.113.10/32"]

# Cost posture for a development account.
enable_nat_gateway       = false
budget_monthly_limit_usd = 50
budget_alert_emails      = ["you@example.com"]

# Development teardown behaviour. Each of these is false/7 by default so that
# `terraform destroy` refuses to remove data it cannot recover. Flip them on
# purpose, for a disposable environment only.
artifact_bucket_force_destroy = false
ecr_force_delete              = false
secret_recovery_window_days   = 7

# Must match the worker's BENCHMARK_JOB_* environment (see .env.example).
benchmark_job_timeout_seconds  = 900
benchmark_job_max_attempts     = 3
sqs_visibility_timeout_seconds = 1200
