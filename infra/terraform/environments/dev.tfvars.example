# Copy to environments/dev.tfvars (gitignored) and edit. Never put passwords here;
# database passwords are generated by Terraform and stored only in Secrets Manager
# and the encrypted remote state. The RDS master password is managed by RDS itself.

region      = "us-east-1"
name_prefix = "queryscale"
environment = "dev"

# Who may reach the unauthenticated API. Replace with your own address(es).
alb_allowed_cidrs = ["203.0.113.10/32"]

# Cost posture for a development account.
enable_nat_gateway       = false
budget_monthly_limit_usd = 50
budget_alert_emails      = ["you@example.com"]

# Database sizing. db.t4g.micro + 20 GiB gp3 is the smallest supported footprint.
db_instance_class        = "db.t4g.micro"
db_allocated_storage     = 20
db_max_allocated_storage = 0
db_multi_az              = false
db_backup_retention_days = 7

# Image tag pushed to ECR (short git SHA). Leave empty until the first push;
# the bootstrap task definition is created only when this is set.
image_tag              = ""
image_cpu_architecture = "X86_64"

# ECS services. The worker stays at 1 (single benchmark database). Set either to 0 to
# pause without destroying. Until the shared job-store adapter lands, the worker cannot
# see API-submitted jobs; it still verifies the image, secrets and database access.
api_cpu              = 256
api_memory           = 512
api_desired_count    = 1
worker_cpu           = 256
worker_memory        = 512
worker_desired_count = 1

# Where tasks run: auto = private subnets with NAT, otherwise public with a public IP.
ecs_tasks_subnet_tier = "auto"

# HTTPS once you own a domain and an ACM certificate; empty keeps HTTP.
acm_certificate_arn = ""

# Alarm recipients (each address must confirm the SNS subscription email).
alarm_emails = []

# Extra non-secret settings for the containers, for the cloud job adapters once they
# exist (see `terraform output container_environment` for the proposed values).
api_extra_environment    = {}
worker_extra_environment = {}
jobs_db_consumers        = []

# Development teardown behaviour. Defaults refuse to destroy anything that holds
# data. Flip these on purpose, for a disposable environment only, then apply once
# BEFORE running terraform destroy (deletion protection is enforced by AWS).
artifact_bucket_force_destroy = false
ecr_force_delete              = false
secret_recovery_window_days   = 7
db_deletion_protection        = true
db_skip_final_snapshot        = false

# Must match the worker's BENCHMARK_JOB_* environment (see .env.example).
benchmark_job_timeout_seconds  = 900
benchmark_job_max_attempts     = 3
sqs_visibility_timeout_seconds = 1200
